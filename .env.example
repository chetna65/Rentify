# Rentify Frontend Environment Configuration
# NOTE: All variables prefixed with VITE_ are exposed to the client bundle.
# NEVER store secrets, private tokens, database credentials, or private API keys here.

# Platform Metadata
VITE_APP_TITLE="Rentify — Verified Rental Housing & Tenant Assistance"

# Canonical Production URL (Configure with your Vercel deployment domain)
VITE_SITE_URL="https://rentify-demo.vercel.app"

# Backend API Endpoint (Placeholder for Render backend deployment)
# Your teammate will configure this when connecting the Render backend service:
VITE_API_BASE_URL="https://rentify-api.onrender.com/api"

# Privacy-friendly Analytics (Optional measurement ID e.g., Plausible domain or GA4 ID)
# Tracking will only activate if the user accepts cookies/analytics in the consent banner.
VITE_ANALYTICS_ID=""
