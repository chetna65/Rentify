# Copy to .env and change every password. .env is git-ignored and must never be committed.
# These values are for LOCAL DEVELOPMENT ONLY.

# --- MySQL 8 ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=rentify
MYSQL_USER=rentify
MYSQL_PASSWORD=change_me_mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Enable TLS/SSL connection (set to true for managed cloud databases like RDS/Cloud SQL)
# MYSQL_SSL=false
# Path to CA certificate file or raw pasted PEM contents
# MYSQL_SSL_CA=

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=mongo_root
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_root
MONGO_DB=rentify
MONGO_APP_USER=rentify_app
MONGO_APP_PASSWORD=change_me_mongo_app
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
# Standalone or cloud MongoDB connection string (including mongodb+srv://)
# When MONGO_URI is set, MONGO_HOST, MONGO_PORT, MONGO_APP_USER, and MONGO_APP_PASSWORD can be omitted
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/rentify?retryWrites=true&w=majority
