# ==========================================
# Rentify Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
# Allowed CORS origin. In production (NODE_ENV=production), this MUST be an https:// URL.
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=72
# Dev OTP code. In production (NODE_ENV=production), this must be set and CANNOT be 123456.
DEV_OTP=123456

# Document uploads directory (defaults to 'uploads' relative to server directory)
# Ephemeral warning is logged at startup in production if running without persistent storage
UPLOAD_DIR=uploads

# ==========================================
# MySQL 8 (Must match database/.env)
# ==========================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rentify
MYSQL_USER=rentify
MYSQL_PASSWORD=change_me_mysql
# Set to true to connect with TLS/SSL (e.g. for managed cloud databases like RDS/Cloud SQL)
# MYSQL_SSL=false
# Path to CA certificate file or raw pasted PEM contents
# MYSQL_SSL_CA=

# ==========================================
# MongoDB 8 (Must match database/.env)
# ==========================================
# If MONGO_URI is set (including mongodb+srv://), it is used directly.
# When MONGO_URI is set, MONGO_HOST, MONGO_PORT, MONGO_APP_USER, and MONGO_APP_PASSWORD are optional.
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/rentify?retryWrites=true&w=majority
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=rentify
MONGO_APP_USER=rentify_app
MONGO_APP_PASSWORD=change_me_mongo_app
